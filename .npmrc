# Electron compatibility - use flat node_modules
node-linker=hoisted

# Auto-install peer dependencies
auto-install-peers=true

# Preserved from original npm config
node-options=--max-old-space-size=5120
update-notifier=false
engine-strict=true

# .erb/scripts/ensure-app-deps.cjs 会从这份 .npmrc 里读 registry，
# 读不到就直接 fail（workspace .npmrc must configure a default registry）。
# 上游私有 CI 有自己的 npmrc，开源仓库这份没有，必须补上。
registry=https://registry.npmjs.org/
